# Server-only credential. Never prefix with NEXT_PUBLIC_.
# Leave blank only for shared unauthenticated attempts. Neighborhood loads usually 429.
SEMANTIC_SCHOLAR_API_KEY=

# Minimum milliseconds between upstream request starts (shared scheduler).
UPSTREAM_MIN_INTERVAL_MS=1100

# Per-request upstream timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=8000

# Set to false to force offline/demo-only operation.
ENABLE_LIVE_API=true

# Recommendation candidate pool: all-cs (default) or recent.
RECOMMENDATION_POOL=all-cs
